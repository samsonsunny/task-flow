{
  "schema": 1,
  "project": "TaskFlow",
  "customerName": "Wednesday Calendar",
  "entryPoint": "AGENTS.md",
  "index": "ai/manifest.json",
  "commands": {
    "build": "xcodebuild -project TaskFlow.xcodeproj -scheme TaskFlow -destination 'generic/platform=iOS Simulator' build",
    "test": "xcodebuild test -project TaskFlow.xcodeproj -scheme TaskFlow -destination 'platform=iOS Simulator,name=iPhone 16'",
    "devtoDraft": "DEVTO_API_KEY=xxx node scripts/publish-devto.mjs <article.md> --draft",
    "devtoPublish": "DEVTO_API_KEY=xxx node scripts/publish-devto.mjs <article.md> --publish",
    "devtoDryRun": "DEVTO_API_KEY=xxx node scripts/publish-devto.mjs <article.md> --dry-run",
    "emailAgentAuth": "./scripts/email-agent --auth",
    "emailAgentCheck": "./scripts/email-agent --check",
    "emailAgentOnce": "./scripts/email-agent --once",
    "emailAgentDaemon": "./scripts/email-agent",
    "appStoreSubmitDryRun": "python3 ci_scripts/appstore_submit.py --version <YY.M.DD> --build-number <n> --dry-run",
    "appStoreSubmitWithNotes": "python3 ci_scripts/appstore_submit.py --version <YY.M.DD> --build-number <n> --release-notes ci_scripts/release_notes_<YY.M.DD>.txt"
  },
  "sourceAreas": {
    "live": [
      "TaskFlow/App",
      "TaskFlow/Models",
      "TaskFlow/DesignSystem",
      "TaskFlow/Views/Components",
      "TaskFlow/Assets.xcassets",
      "TaskFlow/Features/Areas",
      "TaskFlow/Features/Search",
      "TaskFlow/Features/MainTabView.swift"
    ]
  },
  "keyFiles": {
    "appEntry": "TaskFlow/App/TaskFlowApp.swift",
    "rootView": "TaskFlow/App/ContentView.swift",
    "rootTabs": "TaskFlow/Features/MainTabView.swift",
    "domainTasks": "TaskFlow/Features/Areas/DomainTasksView.swift",
    "search": "TaskFlow/Features/Search/SearchView.swift",
    "taskActions": "TaskFlow/Views/Components/TaskRowView.swift",
    "models": "TaskFlow/Models/TaskItem.swift",
    "designSystem": "TaskFlow/DesignSystem/EditorialStyle.swift"
  },
  "schemaVersion": "TaskFlowSchemaV10",
  "fixedTabs": ["Personal", "Work", "Search"],
  "fixedTabGroups": ["Tasks"],
  "fixedDomains": ["Work", "Personal"],
  "doNotCommit": [
    "build/",
    "DerivedData/",
    ".derivedData/",
    ".ralph/",
    ".email-agent/",
    ".env",
    ".DS_Store",
    "*.xcuserdata"
  ]
}
